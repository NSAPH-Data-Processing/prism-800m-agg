all_data$Tmax_C < all_data$Tmin_C |
all_data$Tmin_C > all_data$Tmea_C |
all_data$Tmin_C > all_data$Tmax_C),])
} else { print(":) all temperature values are of correct *relative* magnitude") }
# Save result
