        source code/slurm_runtime_env.sh
        Rscript code/04_Zip2Zcta_Cleaning_PRISM_allyrs_v01.R {input.config}
        """


rule reshape_zcta_outputs:
    input:
        config=CONFIG_PATH,
        nationwide=ZCTA_NATION_OUTPUTS,
    output:
        daily=DAILY_PARQUETS,
        yearly=YEARLY_PARQUETS,
    params:
        daily_dir=lambda wildcards, output: os.path.dirname(output.daily[0]),
        yearly_dir=lambda wildcards, output: os.path.dirname(output.yearly[0]),
        r_version=R_VERSION,
    threads: 4
    resources:
        mem_mb=32000,
        runtime_min=120
    shell:
