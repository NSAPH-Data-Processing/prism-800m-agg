        """


rule block_to_zcta_crosswalk:
    input:
        config=CONFIG_PATH,
        download=DOWNLOAD_DONE,
        zcta=lambda wildcards: crosswalk_zcta_gpkg(wildcards.decyear),
        block_pop=lambda wildcards: crosswalk_block_population(
            wildcards.decyear,
            wildcards.state,
        ),
    output:
        block_to_zcta_file("{decyear}", "{state}"),
    params:
        outdir=lambda wildcards, output: os.path.dirname(output[0]),
        state_idx=state_index,
        r_version=R_VERSION,
    threads: 8
    resources:
        mem_mb=128000,
        runtime_min=480
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        export R_VERSION={params.r_version}
        source code/slurm_runtime_env.sh
        Rscript code/06c_Build_Block_to_ZCTA_Crosswalk_v01.R {params.state_idx} {wildcards.decyear} {input.config}
        """


rule zcta_state_weights:
    input:
        config=CONFIG_PATH,
        state_crosswalks=lambda wildcards: [
            block_to_zcta_file(wildcards.decyear, state)
            for state in STATE_FIPS
        ],
        zcta_pop=lambda wildcards: crosswalk_zcta_population(wildcards.decyear),
    output:
        weights=zcta_state_weight_file("{decyear}"),
        national=national_block_to_zcta_file("{decyear}"),
    params:
        outdir=lambda wildcards, output: os.path.dirname(output.weights),
        r_version=R_VERSION,
    threads: 4
    resources:
        mem_mb=64000,
        runtime_min=240
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        export R_VERSION={params.r_version}
        source code/slurm_runtime_env.sh
        Rscript code/06d_Merge_Block_to_ZCTA_Crosswalk_v01.R {wildcards.decyear} {input.config}
        """


rule zcta_state:
    input:
        config=CONFIG_PATH,
        download=DOWNLOAD_DONE,
        blocks=lambda wildcards: block_file(wildcards.year, wildcards.state),
        crosswalk=lambda wildcards: block_to_zcta_file(
            DECYEAR_BY_YEAR[int(wildcards.year)],
            wildcards.state,
        ),
    output:
        cfg_path(
            "zcta_outdir",
            "zcta_{decyear_abr}",
            "PRISM_ZCTA{decyear_abr}_{year}_{state}.Rds",
        ),
    params:
        decyear=lambda wildcards: check_year_decyear(
            wildcards.year,
            wildcards.decyear_abr,
        ),
        outdir=lambda wildcards, output: os.path.dirname(output[0]),
        state_idx=state_index,
        r_version=R_VERSION,
    threads: 28
    resources:
        mem_mb=128000,
        runtime_min=480
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        export R_VERSION={params.r_version}
        source code/slurm_runtime_env.sh
        Rscript code/03a_BlockPop_Wt_ZCTA_PRISM_800m_v03.R {wildcards.year} {params.state_idx} {input.config}
        """


